keybindings:
    global:
        - key: f12
          command: toggle_debug
        - key: f11
          command: clear_debug_logs
        - key: f10
          command: toggle_debug_focus
        - key: ctrl+c
          command: quit
    normal:
        - key: j
          command: navigate_down
        - key: down
          command: navigate_down
        - key: k
          command: navigate_up
        - key: up
          command: navigate_up
        - key: g
          command: go_to_top
        - key: G
          command: go_to_bottom
        - key: ctrl+d
          command: page_down
        - key: ctrl+u
          command: page_up
        - key: ctrl+h
          command: history_back
        - key: ctrl+l
          command: history_forward
        - key: enter
          command: open_table
        - key: ctrl+p
          command: open_search
        - key: s
          command: open_sql_query
        - key: ':'
          command: open_command_mode
        - key: /
          command: inline_search
        - key: q
          command: quit
    table_view:
        - key: j
          command: navigate_down
        - key: down
          command: navigate_down
        - key: k
          command: navigate_up
        - key: up
          command: navigate_up
        - key: h
          command: navigate_left
        - key: left
          command: navigate_left
        - key: l
          command: navigate_right
        - key: right
          command: navigate_right
        - key: w
          command: navigate_word_forward
        - key: b
          command: navigate_word_backward
        - key: g
          command: go_to_top
        - key: G
          command: go_to_bottom
        - key: ctrl+d
          command: page_down
        - key: ctrl+u
          command: page_up
        - key: ctrl+h
          command: history_back
        - key: ctrl+l
          command: history_forward
        - key: "n"
          command: next_page
        - key: p
          command: previous_page
        - key: i
          command: edit_cell
        - key: "y"
          command: copy_cell_value
        - key: "Y"
          command: copy_row
        - key: enter
          command: open_cell_popup
        - key: v
          command: open_cell_popup
        - key: r
          command: open_record_view
        - key: V
          command: open_record_view
        - key: /
          command: filter_content
        - key: ctrl+p
          command: open_search
        - key: s
          command: open_sql_query
        - key: esc
          command: back
        - key: q
          command: back
    search:
        - key: enter
          command: confirm
        - key: esc
          command: cancel
        - key: up
          command: navigate_up
        - key: down
          command: navigate_down
        - key: ctrl+n
          command: navigate_down
        - key: ctrl+p
          command: navigate_up
    inline_search:
        - key: enter
          command: confirm
        - key: esc
          command: cancel
    command_mode:
        - key: enter
          command: confirm
        - key: esc
          command: cancel
    cell_edit:
        - key: esc
          command: cancel
        - key: enter
          command: insert_newline
        - key: left
          command: cursor_left
        - key: right
          command: cursor_right
        - key: home
          command: cursor_home
        - key: ctrl+a
          command: cursor_home
        - key: end
          command: cursor_end
        - key: ctrl+e
          command: cursor_end
        - key: backspace
          command: backspace
        - key: delete
          command: delete_char
    sql_query:
        - key: enter
          command: confirm
        - key: esc
          command: cancel
        - key: left
          command: cursor_left
        - key: right
          command: cursor_right
        - key: home
          command: cursor_home
        - key: ctrl+a
          command: cursor_home
        - key: end
          command: cursor_end
        - key: ctrl+e
          command: cursor_end
        - key: backspace
          command: backspace
        - key: delete
          command: delete_char
    cell_popup:
        - key: esc
          command: cancel
        - key: q
          command: cancel
        - key: v
          command: cancel
        - key: j
          command: navigate_down
        - key: k
          command: navigate_up
        - key: down
          command: navigate_down
        - key: up
          command: navigate_up
        - key: h
          command: navigate_left
        - key: left
          command: navigate_left
        - key: l
          command: navigate_right
        - key: right
          command: navigate_right
        - key: enter
          command: toggle_json_node
        - key: g
          command: go_to_top
        - key: G
          command: go_to_bottom
    record_view:
        - key: esc
          command: cancel
        - key: q
          command: cancel
        - key: V
          command: cancel
        - key: j
          command: navigate_down
        - key: k
          command: navigate_up
        - key: down
          command: navigate_down
        - key: up
          command: navigate_up
        - key: v
          command: open_cell_popup
        - key: g
          command: go_to_top
        - key: G
          command: go_to_bottom
    debug_panel:
        - key: j
          command: navigate_down
        - key: k
          command: navigate_up
        - key: down
          command: navigate_down
        - key: up
          command: navigate_up
        - key: tab
          command: switch_debug_section
        - key: enter
          command: confirm
        - key: esc
          command: cancel
        - key: g
          command: go_to_top
        - key: G
          command: go_to_bottom
